<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Race tracker hediff. The framework adds it to any pawn whose ThingDef is DZ_Harpy.
       The manipulation penalty lives here so it is tied to actually having wings for arms. -->
  <HediffDef ParentName="BS_DefaultRaceTracker">
    <defName>DZ_HarpyRace</defName>
    <label>harpy</label>
    <description>This individual has feathered wings in place of arms. The wings can grip and carry, but fine manipulation suffers.</description>
    <stages Inherit="False">
      <li>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="BigAndSmall.CompProperties_Race">
        <canSwapAwayFrom>true</canSwapAwayFrom>
      </li>
    </comps>
    <modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <traitIcon>BS_Traits/wings</traitIcon>
      </li>
    </modExtensions>
  </HediffDef>

</Defs>
