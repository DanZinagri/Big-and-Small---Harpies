    <iconPath>DZ/Harpy/UI/Gene_HarpyWings</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1</combatPowerFactor>
    <genes>
      <li>DZ_LandHarpyWings</li>
      <li>Body_FemaleOnly</li>
      <li>Body_Standard</li>
      <li>Body_Thin</li>
      <li>MinTemp_SmallIncrease</li>
      <li MayRequire="sarg.alphagenes">AG_ColdSlowness</li>
      <li>DZ_HarpyEggLaying</li>
      <li>DZ_HarpyTalons</li>
      <li>DZ_HarpyBirdBrained</li>
      <li>DarkVision</li>
      <li>DZ_HarpyHollowBones</li>
      <li>DZ_HarpyHawkeye</li>
      <li>DZ_HarpySerpentEnmity</li>
      <!-- hair colour: one of these is picked per pawn -->
      <li>Hair_Blonde</li>
      <li>Hair_SandyBlonde</li>
      <li>Hair_LightOrange</li>
      <li>Hair_ReddishBrown</li>
      <li>Hair_DarkSaturatedReddish</li>
      <li MayRequire="sarg.alphagenes">AG_Hair_Golden</li>
    </genes>
  </XenotypeDef>

