<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <XenotypeDef>
    <defName>DZ_GarudakinHarpy</defName>
    <label>garudakin harpy</label>
    <description>Small, light harpies descended from the legendary Garuda, whose great wings command the wind itself. They glide easily over rough ground and can hurl blasts of wind that knock enemies aside, but manage tools and fine work poorly.</description>
    <iconPath>DZ/Harpy/UI/Gene_HarpyWings</iconPath>
    <inheritable>true</inheritable>
    <combatPowerFactor>1</combatPowerFactor>
    <genes>
      <li>DZ_GarudakinHarpyWings</li>
      <li>Body_FemaleOnly</li>
      <li>Body_Standard</li>
      <li>Body_Thin</li>
      <li>MinTemp_SmallIncrease</li>
      <li MayRequire="sarg.alphagenes">AG_ColdSlowness</li>
      <li>DZ_HarpyEggLaying</li>
      <li>DZ_HarpyTalons</li>
      <li>DZ_HarpyBirdBrained</li>
      <li>DZ_GarudakinWindblast</li>
      <li>DZ_GarudakinWindstorm</li>
      <li>DZ_HarpyHollowBones</li>
      <li>DZ_HarpyHawkeye</li>
      <li>DZ_HarpySerpentEnmity</li>
      <!-- hair colour: one of these is picked per pawn -->
      <li>Hair_LightBlue</li>
      <li>Hair_LightTeal</li>
      <li>Hair_LightGreen</li>
      <li MayRequire="RedMattis.BigSmall.Core">BS_MossGreenHair</li>
      <li MayRequire="RedMattis.BigSmall.Core">BS_BurgundyHair</li>
      <li>Hair_LightOrange</li>
      <li>Hair_BrightRed</li>
      <li>DZ_Hair_DeepRed</li>
      <li MayRequire="RedMattis.BigSmall.Core">Hair_MediumBlue</li>
    </genes>
  </XenotypeDef>

