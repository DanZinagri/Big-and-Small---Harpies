<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Light, air-filled bones: fragile and weak at carrying, but quick. On every harpy xenotype.
       Caravan carry: vanilla caravan capacity is body size x 35 with no stat, so it goes through VEF's
       VEF_MassCarryCapacity (its worker starts from vanilla's capacity and VEF's MassUtility.Capacity
       patch returns the stat), so x0.8 here really is -20% caravan mass. -->
  <GeneDef>
    <defName>DZ_HarpyHollowBones</defName>
    <label>hollow bones</label>
    <description>Carriers of this gene have light, hollow bones like a bird's. They are quicker on their feet and on the road, but blunt blows hurt them more and they cannot carry as much.</description>
    <iconPath>DZ/Harpy/UI/Gene_HarpyHollowBones</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>779</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <damageFactors>
      <Blunt>1.2</Blunt>
    </damageFactors>
    <statFactors>
      <MoveSpeed>1.2</MoveSpeed>
      <CaravanBonusSpeedFactor>1.2</CaravanBonusSpeedFactor>
      <CarryingCapacity>0.8</CarryingCapacity>
      <VEF_MassCarryCapacity>0.8</VEF_MassCarryCapacity>
    </statFactors>
  </GeneDef>

  <!-- Keen bird-of-prey eyes. On every harpy xenotype. +20% sight = capacity offset 0.2. -->
  <GeneDef>
    <defName>DZ_HarpyHawkeye</defName>
    <label>hawkeye sight</label>
    <description>Carriers of this gene have sharp, far-seeing eyes like a hawk's.</description>
    <iconPath>DZ/Harpy/UI/Gene_HarpyHawkeye</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>780</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <capMods>
      <li>
        <capacity>Sight</capacity>
        <offset>0.2</offset>
      </li>
    </capMods>
  </GeneDef>

  <!-- Bird brained: a milder slow study (vanilla Learning_Slow is x0.5 for met +2). On every harpy. -->
  <GeneDef>
    <defName>DZ_HarpyBirdBrained</defName>
    <label>bird brained</label>
    <description>Carriers of this gene are flighty and easily distracted. They learn new skills and knowledge more slowly.</description>
    <iconPath>UI/Icons/Genes/Gene_SlowLearning</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>781</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <selectionWeight>0</selectionWeight>
    <statFactors>
      <GlobalLearningFactor>0.8</GlobalLearningFactor>
    </statFactors>
  </GeneDef>

  <!-- Poultry harpies butcher into chicken meat instead of human meat. The framework's
       PawnExtension.meatOverride swaps the race's meat (DZ_Harpy uses Human meat) for this ThingDef at
       the same stack count when the corpse is butchered. Meat_Chicken is generated by vanilla from the
       chicken race before cross-references resolve, so it can be named here. Free: it only changes
       what the corpse yields. -->
  <GeneDef>
    <defName>DZ_HarpyPoultryMeat</defName>
    <label>poultry meat</label>
    <description>Carriers of this gene have flesh like a chicken's. Their corpses butcher into chicken meat rather than human meat.</description>
    <iconPath>DZ/Harpy/UI/Gene_HarpyPoultryMeat</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>783</displayOrderInCategory>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>0</selectionWeight>
    <customEffectDescriptions>
      <li>Butchers into chicken meat instead of human meat.</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <meatOverride>Meat_Chicken</meatOverride>
      </li>
    </modExtensions>
  </GeneDef>

</Defs>
